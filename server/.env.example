PORT=3001

# Consigue tu key en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Consigue tu key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Proveedor de IA a usar: "anthropic" o "gemini".
AI_PROVIDER=gemini

# Respaldo automático (opcional): si el proveedor principal falla (cuota agotada, error, etc.),
# se reintenta con Groq. Conseguí una key gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Base de datos remota (turso.tech) — crea una base y conseguí estos dos valores
# en su dashboard o con `turso db show <nombre> --url` / `turso db tokens create <nombre>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Límites de uso de la IA (solo cuentan las respuestas nuevas, no las cacheadas).
# Por IP por hora, y un tope global por día para acotar el gasto del demo.
AI_RATE_LIMIT_PER_HOUR=20
AI_DAILY_LIMIT=300

# Tu código de sincronización (Guardado → Código de sincronización en la app).
# Ese usuario no tiene límite de uso de la IA.
OWNER_USER_ID=
